# ── Database (Supabase) ───────────────────────────────────────────────────────
# Project Settings → Database → Connection string → URI
# Prefer "Transaction" pooler (port 6543) for many short queries, or
# "Session" / direct (5432) for long-lived Render Node process.
# Example direct:  postgresql://postgres.[ref]:[password]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
# Example pooler:  postgresql://postgres.[ref]:[password]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres.xxxx:YOUR_PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# Optional pool size (default 10). Keep low on Supabase free/pro pooler limits.
# DB_POOL_MAX=10

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate: openssl rand -base64 48
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-min-32-chars

# Public URL of this app on Render (used for CORS)
# e.g. https://scholarbase.onrender.com
FRONTEND_URL=https://scholarbase.onrender.com

# Platform owner(s) — comma-separated emails for Admin dashboard
OWNER_EMAIL=you@email.com

# ── Africa's Talking SMS ──────────────────────────────────────────────────────
AT_API_KEY=your-africastalking-api-key
AT_USERNAME=your-africastalking-username

# ── Client (baked in at build time on Render — set as env vars before build) ─
# WhatsApp support number (Uganda: 256XXXXXXXXX, no +)
VITE_SUPPORT_PHONE=256700000000

# Optional analytics (Umami)
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=
